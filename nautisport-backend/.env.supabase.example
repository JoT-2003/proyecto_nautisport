# Copia este archivo como ".env.supabase" y completa los valores.
# Este archivo NO se sube a Git.
#
# Dónde encontrar cada dato en Supabase:
#   Project Settings → API
#     - Project URL                     → SUPABASE_URL
#     - anon public / publishable       → SUPABASE_ANON_KEY
#     - service_role / secret (¡secreta!) → SUPABASE_SERVICE_ROLE_KEY
#
# Si tu proyecto usa las claves nuevas (sb_publishable_... / sb_secret_...),
# puedes ponerlas en SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY; el script
# también acepta SUPABASE_PUBLISHABLE_KEY y SUPABASE_SECRET_KEY.
#   Project Settings → Database → Connection strings
#     - Session pooler (puerto 5432)     → DATABASE_URL_SUPABASE
#
# La service_role key se usa SOLO en tu computador para crear los
# usuarios demo. Nunca la pongas en Vercel ni en el frontend.
#
# Para desplegar la Edge Function puedes usar `npx supabase login` o crear
# un Personal Access Token en https://supabase.com/dashboard/account/tokens
# y pegarlo aquí. Es opcional si ya iniciaste sesión con la CLI.

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
# Opcional: se deduce de SUPABASE_URL. Útil si usas un dominio propio.
# SUPABASE_PROJECT_REF=TU_PROYECTO
# SUPABASE_ACCESS_TOKEN=sbp_...

# Session pooler, puerto 5432, con SSL.
# Si la contraseña tiene caracteres especiales, codifícalos en URL (@ → %40, # → %23).
DATABASE_URL_SUPABASE=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres?sslmode=require
