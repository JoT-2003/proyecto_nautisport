# Copia este archivo como ".env.supabase" y pega aquí la cadena de Supabase.
# Usa la URL de "Session pooler" (puerto 5432), NO la de Transaction pooler (6543).
# Si la contraseña tiene caracteres especiales, codifícalos en URL (ej: @ -> %40, # -> %23).
#
# Formato (Session pooler):
# postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# Formato (conexión directa, también válida):
# postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres?sslmode=require

DATABASE_URL_SUPABASE=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres?sslmode=require
