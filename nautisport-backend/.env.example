# Local PostgreSQL: copia este archivo como ".env" y completa TU contraseña local
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/nautisport_db
PORT=4000
# Secreto usado para firmar los JWT (cámbialo por uno largo y aleatorio)
JWT_SECRET=CAMBIA_ESTE_SECRETO

# Para migrar/apuntar a Supabase, crea también ".env.supabase" a partir de
# ".env.supabase.example" (ver scripts/supabase/README.md)
